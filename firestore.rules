rules_version = '2';
// Regras do Firestore do Fimapa: cada projeto pertence a quem criou (owner);
// quem está na lista "members" (e-mails) só pode abrir.
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{id} {
      allow read: if request.auth != null && (
        resource.data.owner == request.auth.uid ||
        request.auth.token.email.lower() in resource.data.get('members', []));
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
